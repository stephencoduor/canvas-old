{
  "manifest_version": 3,
  "name": "Instructor Toolkit for Canvas",
  "short_name": "Instructor Toolkit",
  "description": "Bulk-edit module dates, audit copied courses and grade faster in SpeedGrader. A toolkit for Canvas LMS instructors.",
  "version": "0.0.0",
  "minimum_chrome_version": "110",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Instructor Toolkit for Canvas" },
  "options_page": "options.html",
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://*.instructure.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://*.instructure.com/courses/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "storage": { "managed_schema": "managed_schema.json" }
}
